<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-time stand-in for the game's ModApi.dll (Eleon's newer mod interface), written from its public
    signatures. Never shipped: the game provides the real ModApi.dll. Only the two members EAM uses are declared;
    everything else is reached by reflection at run time.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ModApi</AssemblyName>
    <RootNamespace>Eleon.Modding</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
